    "Reminders are scheduled on your device. Flow does not use a server to send them, and you can turn them off at any time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnerungen werden auf deinem Gerät geplant. Flow nutzt keinen Server, um sie zu senden, und du kannst sie jederzeit deaktivieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios se programan en tu dispositivo. Flow no usa ningún servidor para enviarlos y puedes desactivarlos cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels sont programmés sur votre appareil. Flow n'utilise aucun serveur pour les envoyer et vous pouvez les désactiver à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I promemoria vengono programmati sul tuo dispositivo. Flow non usa alcun server per inviarli e puoi disattivarli in qualsiasi momento."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hatırlatmalar cihazında planlanır. Flow bunları göndermek için bir sunucu kullanmaz ve istediğin zaman kapatabilirsin."
          }
        }
      }
    },
