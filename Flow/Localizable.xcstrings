    "Your transactions are stored in your private iCloud database. Only you can see them, and they come back if you reinstall Flow." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Transaktionen werden in deiner privaten iCloud-Datenbank gespeichert. Nur du kannst sie sehen, und sie sind wieder da, wenn du Flow neu installierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus transacciones se guardan en tu base de datos privada de iCloud. Solo tú puedes verlas y vuelven si reinstalas Flow."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos transactions sont stockées dans votre base de données iCloud privée. Vous seul pouvez les voir, et elles reviennent si vous réinstallez Flow."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue transazioni sono salvate nel tuo database iCloud privato. Solo tu puoi vederle e tornano se reinstalli Flow."
