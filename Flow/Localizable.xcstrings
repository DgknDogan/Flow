    "Categorize your daily expenses instantly and see exactly where your money goes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordne deine täglichen Ausgaben sofort zu und sieh genau, wohin dein Geld fließt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clasifica tus gastos diarios al instante y descubre exactamente adónde va tu dinero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classez vos dépenses quotidiennes en un instant et voyez exactement où va votre argent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classifica le spese quotidiane in un attimo e scopri esattamente dove vanno i tuoi soldi."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlük harcamalarını anında kategorilere ayır ve paranın tam olarak nereye gittiğini gör."
          }
        }
      }
    },
    "Changes" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambios"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifications"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiche"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Değişiklikler"
          }
        }
      }
    },
    "Charts, summaries and insights in Flow are based only on the data you enter. They are for your personal information and are not financial, tax or investment advice." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagramme, Übersichten und Analysen in Flow beruhen nur auf den Daten, die du eingibst. Sie dienen deiner persönlichen Information und sind keine Finanz-, Steuer- oder Anlageberatung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los gráficos, resúmenes y análisis de Flow se basan únicamente en los datos que introduces. Son solo informativos y no constituyen asesoramiento financiero, fiscal ni de inversión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les graphiques, résumés et analyses de Flow reposent uniquement sur les données que vous saisissez. Ils sont fournis à titre informatif et ne constituent pas un conseil financier, fiscal ou en investissement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafici, riepiloghi e analisi di Flow si basano solo sui dati che inserisci. Hanno scopo puramente informativo e non costituiscono consulenza finanziaria, fiscale o sugli investimenti."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow'daki grafikler, özetler ve analizler yalnızca girdiğin verilere dayanır. Kişisel bilgilendirme amaçlıdır; finansal, vergi veya yatırım tavsiyesi değildir."
          }
        }
      }
    },
    "Choose how Flow looks. System follows your device appearance." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, wie Flow aussieht. „System“ folgt dem Erscheinungsbild deines Geräts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige el aspecto de Flow. Sistema sigue la apariencia de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez l'apparence de Flow. Système suit l'apparence de votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli l'aspetto di Flow. Sistema segue l'aspetto del dispositivo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow'un görünümünü seç. Sistem, cihazının görünümünü izler."
          }
        }
      }
    },
    "Choose Month" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
