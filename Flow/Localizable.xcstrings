            "state" : "translated",
            "value" : "Les réponses peuvent être inexactes et ne constituent pas un conseil financier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le risposte potrebbero essere imprecise e non costituiscono consulenza finanziaria."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cevaplar hatalı olabilir ve finansal tavsiye değildir."
          }
        }
      }
    },
