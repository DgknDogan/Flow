    "Ask about your spending and income. Everything runs on your device, so your data never leaves it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stell Fragen zu deinen Ausgaben und Einnahmen. Alles läuft auf deinem Gerät, deine Daten verlassen es also nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta sobre tus gastos e ingresos. Todo funciona en tu dispositivo, así que tus datos nunca salen de él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez vos questions sur vos dépenses et vos revenus. Tout fonctionne sur votre appareil : vos données ne le quittent jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai domande sulle tue spese e sulle tue entrate. Tutto funziona sul tuo dispositivo, quindi i tuoi dati non lo lasciano mai."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harcamaların ve gelirlerin hakkında soru sor. Her şey cihazında çalışır, verilerin cihazından çıkmaz."
          }
        }
      }
    },
