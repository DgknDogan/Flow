    "A new week has started. Take a look at last week's spending in Flow." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine neue Woche hat begonnen. Wirf in Flow einen Blick auf deine Ausgaben der letzten Woche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha empezado una nueva semana. Echa un vistazo en Flow a tus gastos de la semana pasada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une nouvelle semaine commence. Jetez un œil à vos dépenses de la semaine dernière dans Flow."
