    "Flow does not collect, sell or share your personal data. There are no accounts, ads, analytics or tracking in the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow erfasst, verkauft und teilt keine personenbezogenen Daten. Die App hat keine Accounts, keine Werbung, keine Analysen und kein Tracking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow no recopila, vende ni comparte tus datos personales. En la app no hay cuentas, anuncios, analíticas ni seguimiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow ne collecte, ne vend, ni ne partage vos données personnelles. L'app ne comporte ni compte, ni publicité, ni outil d'analyse, ni suivi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow non raccoglie, vende né condivide i tuoi dati personali. Nell'app non ci sono account, pubblicità, strumenti di analisi o tracciamento."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow kişisel verilerini toplamaz, satmaz veya paylaşmaz. Uygulamada hesap, reklam, analiz veya takip yoktur."
          }
        }
      }
    },
    "Flow is a personal budgeting tool that helps you record your income and expenses. By using the app you agree to these terms. If you do not agree, please do not use Flow." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow ist ein persönliches Budget-Tool, mit dem du deine Einnahmen und Ausgaben erfasst. Mit der Nutzung der App stimmst du diesen Bedingungen zu. Wenn du nicht zustimmst, nutze Flow bitte nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow es una herramienta de presupuesto personal que te ayuda a registrar tus ingresos y gastos. Al usar la app aceptas estas condiciones. Si no estás de acuerdo, no uses Flow."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow est un outil de gestion de budget personnel qui vous aide à enregistrer vos revenus et vos dépenses. En utilisant l'app, vous acceptez ces conditions. Si vous ne les acceptez pas, n'utilisez pas Flow."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow è uno strumento di gestione del budget personale che ti aiuta a registrare entrate e spese. Usando l'app accetti questi termini. Se non li accetti, non usare Flow."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow, gelir ve giderlerini kaydetmene yardımcı olan kişisel bir bütçe aracıdır. Uygulamayı kullanarak bu koşulları kabul etmiş olursun. Kabul etmiyorsan lütfen Flow'u kullanma."
          }
        }
      }
    },
    "Flow is built with Apple frameworks, including SwiftUI, SwiftData, CloudKit, Swift Charts and Local Authentication." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow ist mit Apple-Frameworks entwickelt, darunter SwiftUI, SwiftData, CloudKit, Swift Charts und Local Authentication."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow está creada con frameworks de Apple, como SwiftUI, SwiftData, CloudKit, Swift Charts y Local Authentication."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow est conçu avec les frameworks Apple, dont SwiftUI, SwiftData, CloudKit, Swift Charts et Local Authentication."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow è realizzato con i framework Apple, tra cui SwiftUI, SwiftData, CloudKit, Swift Charts e Local Authentication."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow; SwiftUI, SwiftData, CloudKit, Swift Charts ve Local Authentication gibi Apple çerçeveleriyle geliştirildi."
          }
        }
      }
    },
    "Flow is Locked" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow ist gesperrt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow está bloqueada"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow est verrouillé"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow è bloccato"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow Kilitli"
          }
        }
      }
    },
    "Flow is provided \"as is\". We work to keep it reliable, but we cannot guarantee it will always be free of errors or that data can be recovered after it is deleted or lost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow wird „wie besehen“ bereitgestellt. Wir arbeiten daran, dass die App zuverlässig ist, können aber nicht garantieren, dass sie immer fehlerfrei ist oder dass gelöschte oder verlorene Daten wiederhergestellt werden können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow se ofrece «tal cual». Trabajamos para que sea fiable, pero no podemos garantizar que esté siempre libre de errores ni que se puedan recuperar los datos eliminados o perdidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow est fourni « en l'état ». Nous faisons en sorte qu'il soit fiable, mais nous ne pouvons pas garantir qu'il sera toujours exempt d'erreurs ni que des données supprimées ou perdues pourront être récupérées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow viene fornito «così com'è». Ci impegniamo a mantenerlo affidabile, ma non possiamo garantire che sia sempre privo di errori né che i dati eliminati o persi possano essere recuperati."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flow \"olduğu gibi\" sunulur. Güvenilir olması için çalışıyoruz ancak her zaman hatasız olacağını veya silinen ya da kaybolan verilerin geri getirilebileceğini garanti edemeyiz."
          }
        }
      }
    },
    "Forgot to log something yesterday? Add it to Flow now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestern etwas vergessen einzutragen? Füge es jetzt in Flow hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Olvidaste registrar algo ayer? Añádelo ahora en Flow."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez oublié de noter quelque chose hier ? Ajoutez-le maintenant dans Flow."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai dimenticato di registrare qualcosa ieri? Aggiungilo ora in Flow."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dün kaydetmeyi unuttuğun bir harcama mı var? Hemen Flow'a ekle."
          }
        }
      }
    },
