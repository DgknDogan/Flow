    "App Lock" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Sperre"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bloqueo de la app"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrouillage de l'app"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blocco app"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama Kilidi"
          }
        }
      }
    },
    "App Lock uses Face ID, Touch ID or your device passcode through iOS. Flow only learns whether the check succeeded; your biometric data never leaves the Secure Enclave." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App-Sperre nutzt Face ID, Touch ID oder den Gerätecode über iOS. Flow erfährt nur, ob die Prüfung erfolgreich war; deine biometrischen Daten verlassen nie die Secure Enclave."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El bloqueo de la app usa Face ID, Touch ID o el código de tu dispositivo a través de iOS. Flow solo sabe si la verificación se ha realizado correctamente; tus datos biométricos nunca salen del Secure Enclave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le verrouillage de l'app utilise Face ID, Touch ID ou le code de votre appareil via iOS. Flow sait seulement si la vérification a réussi ; vos données biométriques ne quittent jamais la Secure Enclave."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il blocco app usa Face ID, Touch ID o il codice del dispositivo tramite iOS. Flow sa solo se la verifica è riuscita; i tuoi dati biometrici non lasciano mai la Secure Enclave."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama Kilidi, iOS aracılığıyla Face ID, Touch ID veya cihaz parolanı kullanır. Flow yalnızca doğrulamanın başarılı olup olmadığını öğrenir; biyometrik verilerin Secure Enclave'den hiçbir zaman çıkmaz."
          }
        }
      }
    },
