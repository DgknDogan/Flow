    "Transactions, categories, notes, your budget, your name and your profile photo are stored only on your device. We never receive a copy of them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transaktionen, Kategorien, Notizen, dein Budget, dein Name und dein Profilfoto werden nur auf deinem Gerät gespeichert. Wir erhalten nie eine Kopie davon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las transacciones, categorías, notas, tu presupuesto, tu nombre y tu foto de perfil se guardan solo en tu dispositivo. Nunca recibimos una copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les transactions, catégories, notes, votre budget, votre nom et votre photo de profil sont stockés uniquement sur votre appareil. Nous n'en recevons jamais de copie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transazioni, categorie, note, budget, nome e foto profilo vengono salvati solo sul tuo dispositivo. Non ne riceviamo mai una copia."
          }
        },
        "tr" : {
          "stringUnit" : {
